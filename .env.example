# Copie para .env e ajuste. O .env NAO vai para o git.
#
# IMPORTANTE: aponte para um caminho FORA do OneDrive.
# Datasets tem dezenas de milhares de imagens; deixar dentro da pasta
# sincronizada faz o OneDrive tentar subir tudo e travar a maquina.
ASTRO_DATA_ROOT=C:/astro-data

# Device de treino/inferencia: cuda | cpu | auto
ASTRO_DEVICE=auto

# Porta da API de inferencia
ASTRO_API_PORT=8000

# Modo da API: mock (respostas sinteticas, sem modelo) | real
ASTRO_API_MODE=mock
