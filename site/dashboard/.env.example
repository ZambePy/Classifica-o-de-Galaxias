# Copie para .env (o Node lê automaticamente) ou defina no painel da hospedagem. Nunca publique o .env.
PORT=3001
NODE_ENV=development
# Chave que o script do modelo usa para publicar resultados em POST /api/classifications
MODEL_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Endereço da API do classificador (FastAPI na raiz deste repositório, contrato 1.x). Só na rede interna.
# Ligue com: npm run dev:classificador (simulado) ou npm run dev:classificador:real (com os modelos)
ML_SERVICE_URL=http://127.0.0.1:8000
# Envios de imagem por minuto, por endereço (proteção contra abuso). Acima disso o site responde 429
CLASSIFY_PER_MINUTE=10
# 1 = ao ligar, o Node manda uma imagem pequena gerada em memória para a IA (modo real) já carregar os modelos.
# Se a API estiver fora, tenta de novo a cada 30 s, no máximo 5 vezes
CLASSIFIER_WARMUP=1

# --- classificador (FastAPI do colega) ---
# Não vai aqui: o script ferramentas/integracao/iniciar-classificador.ps1 define
# ASTRO_API_MODE (mock ou real) e ASTRO_DATA_ROOT (pasta ../modelos) ao ligar a API.

# --- chat do site ---
# Sem nada configurado, o chat usa respostas de demonstração.
# Para usar uma API de IA no formato "chat completions":
CHAT_PROVIDER=
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=
